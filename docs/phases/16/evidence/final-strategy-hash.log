import hashlib
files = ['src/domain/trading/strategy.py', 'config/paper.yaml']
h = hashlib.sha256()
for f in sorted(files):
    with open(f, 'rb') as fh:
        h.update(fh.read())
print(f'strategy_hash={h.hexdigest()[:16]}')

