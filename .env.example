# --- LLM Providers (Fase 08+) ---
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# --- Bybit (Fase 12+) ---
# Testnet primero. LIVE permanece DESHABILITADO por defecto (PRD §49-50).
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=true

# --- Modo de trading ---
# Valores: backtest | replay | paper | testnet | live
TRADING_MODE=backtest
LIVE_TRADING_ENABLED=false
