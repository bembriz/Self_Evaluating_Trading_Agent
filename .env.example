# ============================================================
# Self-Evaluating Trading Agent — Plantilla de secretos
# Copiar a .env y completar. NUNCA versionar .env real.
# ============================================================

# --- LLM Providers (Fase 08) ---
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
# Presupuestos LLM en USD (PRD §60); defaults en config/base.yaml
LLM_EXPERIMENT_BUDGET_USD=
LLM_MONTHLY_BUDGET_USD=

# --- Bybit (Fase 12+) ---
# Testnet primero. LIVE permanece DESHABILITADO por defecto (PRD §49-50).
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=true

# --- Modo de trading ---
# Valores: backtest | replay | paper | testnet | live
TRADING_MODE=paper
LIVE_TRADING_ENABLED=false
PAPER_DECISION_SOURCE=baseline
PAPER_SYMBOLS='["ETHUSDT"]'
PAPER_TIMEFRAME=15m
PAPER_REPORT_INTERVAL_HOURS=24
# 30d de certificación + margen 15d ⇒ 45 (0 = sin límite). <45 con session_id ⇒ START rechazado.
PAPER_MAX_RUNTIME_DAYS=45
PAPER_REPORT_DIR=reports/paper
PAPER_CERTIFICATION_STATE_PATH=docs/phases/16/certification-state.json
# Identificador de sesión paper (opcional; si se omite se deriva de timeframe+símbolo)
PAPER_SESSION_ID=
# Timeout de stale del stream kline del paper-runner (push frequency 1-60s → 120s seguro)
PAPER_STALE_TIMEOUT_SECONDS=120
# Host/puerto del servidor /metrics del paper-runner (bind loopback; sin publicar)
PAPER_METRICS_HOST=0.0.0.0
PAPER_METRICS_PORT=9090

# --- Identidad de artefacto para certificación (Fase 16c.7) ---
# GIT_COMMIT: SHA final integrado (FINAL_DEPLOY_SHA) tras el merge; se INYECTA en el APPLY.
# 8188e85… es solo la base histórica de 16c, NO la identidad final de deployment.
GIT_COMMIT=
# DOCKER_IMAGE_DIGEST: digest real de la imagen; se INYECTA tras el build definitivo
# (capturar con `docker inspect`). NO hardcodear el digest del candidato de preflight.
DOCKER_IMAGE_DIGEST=
# Evidencia de safeguard drills (ruta persistente dentro del contenedor, bind ./safeguard)
PAPER_SAFEGUARD_EVIDENCE_PATH=/app/safeguard/safeguard-evidence.json

# --- Observabilidad (Prometheus) ---
# Retención TSDB; >=45d para cubrir la ventana de certificación.
PROMETHEUS_RETENTION=45d
