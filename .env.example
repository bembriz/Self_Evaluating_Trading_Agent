# ============================================================
# Self-Evaluating Trading Agent — Plantilla de secretos
# Copiar a .env y completar. NUNCA versionar .env real.
# ============================================================

# --- LLM Providers (Fase 08) ---
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
# Presupuestos LLM en USD (PRD §60); defaults en config/base.yaml
LLM_EXPERIMENT_BUDGET_USD=
LLM_MONTHLY_BUDGET_USD=

# --- Bybit (Fase 12+) ---
# Testnet primero. LIVE permanece DESHABILITADO por defecto (PRD §49-50).
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=true

# --- Modo de trading ---
# Valores: backtest | replay | paper | testnet | live
TRADING_MODE=paper
LIVE_TRADING_ENABLED=false
PAPER_DECISION_SOURCE=baseline
PAPER_SYMBOLS='["ETHUSDT"]'
PAPER_TIMEFRAME=15m
PAPER_REPORT_INTERVAL_HOURS=24
PAPER_MAX_RUNTIME_DAYS=7
PAPER_REPORT_DIR=reports/paper
PAPER_CERTIFICATION_STATE_PATH=docs/phases/16/certification-state.json
# Identificador de sesión paper (opcional; si se omite se deriva de timeframe+símbolo)
PAPER_SESSION_ID=
